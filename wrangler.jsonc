{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sushiki-hodoki",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sushiki-hodoki.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["13 20 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sushiki-hodoki",
      "database_id": "24c792f0-0bb2-4abf-b826-81f82ac15ac5",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
